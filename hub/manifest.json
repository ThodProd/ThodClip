{
  "schemaVersion": 1,
  "hubApi": 1,
  "id": "thodclip",
  "version": "1.1.1",
  "platform": "win-x64",
  "mode": "embedded",
  "ui": "ui/index.html",
  "worker": {
    "executable": "worker/ThodClip.Worker.exe",
    "arguments": []
  },
  "integration": {
    "executable": "worker/ThodClip.Worker.exe",
    "arguments": ["--register-integrations"]
  },
  "cleanup": {
    "executable": "worker/ThodClip.Worker.exe",
    "arguments": ["--uninstall-integrations"]
  },
  "permissions": [
    "worker",
    "files.export"
  ]
}
